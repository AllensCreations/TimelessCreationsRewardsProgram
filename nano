import 'dotenv/config';
import { runSql } from './lib/db.js';
import { handleBotMessage } from './lib/botHandler.js';

async function runMessengerBotTester() {
  console.log("🤖 ========================================");
  console.log("🤖 STARTING MESSENGER BOT COMPREHENSIVE TESTER");
  console.log("🤖 ========================================\n");

  const testPsid = "PHONE_TEST_PSID_" + Date.now().toString().slice(-4);
  const testEmail = "elder.tester@missionary.org";

  try {
    // ----------------------------------------------------
    // TEST 1: Clean slate / Reset session
    // ----------------------------------------------------
    console.log("📋 [Test 1] Simulating Brand New User (First interaction / 'Get Started')...");
    await runSql("DELETE FROM sessions WHERE psid = ?", [testPsid]);
    await runSql("DELETE FROM missionaries WHERE psid = ? OR email = ?", [testPsid, testEmail]);

    // Send "Get Started" or arbitrary text
    await handleBotMessage(testPsid, "Get Started");

    let session = (await runSql("SELECT * FROM sessions WHERE psid = ?", [testPsid]))[0];
    assert(session && session.state === 'AWAITING_REFERRAL', "New user correctly enters AWAITING_REFERRAL state");
    console.log("   ✅ [PASS] Bot prompted for Referral Code.\n");

    // ----------------------------------------------------
    // TEST 2: Referral Code Entry (e.g. TCRP50)
    // ----------------------------------------------------
    console.log("📋 [Test 2] Simulating User entering Global Referral Code 'TCRP50'...");
    // Ensure global referral pool has TCRP50
    await runSql(`
      INSERT INTO system_config (key, value) VALUES ('global_pool_test', '1')
      ON CONFLICT(key) DO UPDATE SET value = '1'
    `);
    // Insert dummy global row if table exists or mock success
    try {
      await runSql("INSERT INTO global_referral_pool (code, uses_count, max_limit) VALUES ('TCRP50', 0, 100) ON CONFLICT(code) DO NOTHING");
    } catch(e) {}

    await handleBotMessage(testPsid, "TCRP50");

    session = (await runSql("SELECT * FROM sessions WHERE psid = ?", [testPsid]))[0];
    assert(session && session.state === 'AWAITING_TERMS', "Session transitions to AWAITING_TERMS after valid code");
    console.log("   ✅ [PASS] Referral code accepted & terms prompt displayed.\n");

    // ----------------------------------------------------
    // TEST 3: Terms Agreement
    // ----------------------------------------------------
    console.log("📋 [Test 3] Simulating User agreeing to Terms & Conditions...");
    await handleBotMessage(testPsid, "I agree", "TERMS_AGREE");

    session = (await runSql("SELECT * FROM sessions WHERE psid = ?", [testPsid]))[0];
    assert(session && session.state === 'AWAITING_NAME_EMAIL', "Session transitions to AWAITING_NAME_EMAIL");
    console.log("   ✅ [PASS] Terms accepted & name/email input requested.\n");

    // ----------------------------------------------------
    // TEST 4: Name & Missionary Email Input
    // ----------------------------------------------------
    console.log("📋 [Test 4] Simulating User providing Name and @missionary.org email...");
    const nameEmailInput = `Elder Tester\n${testEmail}`;
    await handleBotMessage(testPsid, nameEmailInput);

    session = (await runSql("SELECT * FROM sessions WHERE psid = ?", [testPsid]))[0];
    assert(session && session.state === 'AWAITING_OTP', "Session transitions to AWAITING_OTP and generates passcode");
    assert(session.otp_code && session.otp_code.length === 6, "A 6-digit OTP code was successfully generated");
    console.log(`   ✅ [PASS] OTP Code generated successfully for test: [ ${session.otp_code} ]\n`);

    // ----------------------------------------------------
    // TEST 5: OTP Code Verification
    // ----------------------------------------------------
    console.log("📋 [Test 5] Simulating User entering the correct 6-digit OTP code...");
    const generatedOtp = session.otp_code;
    await handleBotMessage(testPsid, generatedOtp);

    // Verify missionary is now successfully created & linked to PSID
    const missionary = (await runSql("SELECT * FROM missionaries WHERE psid = ? LIMIT 1", [testPsid]))[0];
    assert(missionary !== undefined, "Missionary account successfully created and linked in database");
    assert(missionary.email === testEmail, "Missionary email matches input");
    assert(Number(missionary.points) === 1, "Missionary received 1 welcome reward point");
    
    // Verify session row is cleaned up
    session = (await runSql("SELECT * FROM sessions WHERE psid = ?", [testPsid]))[0];
    assert(session === undefined, "Onboarding session is cleared after successful verification");
    console.log("   ✅ [PASS] Account verified, linked to PSID, awarded 1 Point, and session cleared!\n");

    // ----------------------------------------------------
    // TEST 6: Returning Verified User (Dashboard Flow)
    // ----------------------------------------------------
    console.log("📋 [Test 6] Simulating Returning Verified User sending a message...");
    // Sending a random message or clicking dashboard should render the dashboard directly instead of onboarding
    await handleBotMessage(testPsid, "Hello bot!");
    
    // Check that chat messages recorded user & bot interaction
    const recentMessages = await runSql("SELECT sender, message FROM chat_messages WHERE psid = ? ORDER BY id DESC LIMIT 2", [testPsid]);
    assert(recentMessages.length >= 2, "Chat messages logged properly for verified user");
    console.log("   ✅ [PASS] Verified user bypassed onboarding and triggered dashboard review successfully!\n");

    // ----------------------------------------------------
    // TEST 7: Reset Command Testing ('RESET')
    // ----------------------------------------------------
    console.log("📋 [Test 7] Simulating User texting 'RESET' command...");
    await handleBotMessage(testPsid, "RESET");

    const resetMissionary = (await runSql("SELECT psid FROM missionaries WHERE email = ?", [testEmail]))[0];
    assert(resetMissionary?.psid === null || resetMissionary?.psid === undefined, "Missionary PSID unlinked on RESET");
    console.log("   ✅ [PASS] RESET command successfully unlinked the test account.\n");

    console.log("🎉 ========================================");
    console.log("🎉 ALL MESSENGER BOT TESTS PASSED SUCCESSFULLY!");
    console.log("🎉 ========================================\n");

  } catch (err) {
    console.error("❌ Test Suite Failed with Error:", err);
    process.exit(1);
  }
}

function assert(condition, message) {
  if (!condition) {
    throw new Error(`Assertion Failed: ${message}`);
  }
}

runMessengerBotTester();
