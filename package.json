{
  "name": "timelesscreationsrewardsprogram",
  "version": "1.0.0",
  "description": "TCRP Missionary Rewards & Automated Drip Program",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node test-master.js",
    "test:html": "node test-html.js",
    "build": "mkdir -p public/assets && cp -r views/* public/ 2>/dev/null || true && cp -r assets/* public/assets/ 2>/dev/null || true",
    "prune": "node -r dotenv/config -e \"import('./lib/dbPruner.js').then(m => m.runDatabaseMaintenance())\"",
    "organize": "mkdir -p codebase_archives && mv -f *_codebase.txt codebase_archives/ 2>/dev/null || true"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "firebase": "^10.12.0"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "undici": "^8.10.0"
  }
}