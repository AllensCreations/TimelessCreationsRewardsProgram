{
  "name": "timelesscreationsrewardsprogram",
  "version": "3.3.0",
  "versionCode": 89,
  "description": "TCRP Missionary Rewards & Automated Drip Program",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/test-master.js",
    "test:all": "node tests/run-all.js",
    "test:bot": "node tests/test-messenger-bot.js",
    "test:hub": "node tests/test-bot-check-hub.js",
    "test:replies": "node tests/test-all-replies.js",
    "test:antispam": "node tests/botAntiSpamAndQuotas.test.js",
    "test:templates": "node tests/test-templates.js",
    "test:html": "node tests/test-html.js",
    "test:consolidated": "node tests/tester.consolidated.js all",
    "test:backend": "node tests/backendSuggestionsAndCohort.test.js",
    "test:cdn": "node tests/test-cdn.js",
    "build": "node scripts/sync-assets.js",
    "build:apk": "node scripts/sync-assets.js && cd android/android-tcrp && ./gradlew assembleRelease",
    "prune": "node -r dotenv/config -e \"import('./lib/dbPruner.js').then(m => m.runDatabaseMaintenance())\"",
    "organize": "mkdir -p codebase_archives && mv -f *_codebase.txt codebase_archives/ 2>/dev/null || true"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "firebase": "^10.12.0"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "undici": "^8.10.0"
  }
}
