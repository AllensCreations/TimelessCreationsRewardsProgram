{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/views/index.html" },
    { "source": "/pusher.html", "destination": "/views/pusher.html" },
    { "source": "/invoicing.html", "destination": "/views/invoicing.html" },
    { "source": "/highlight.html", "destination": "/views/highlight.html" },
    { "source": "/settings.html", "destination": "/views/settings.html" },
    { "source": "/manifest.json", "destination": "/views/manifest.json" },
    { "source": "/sw.js", "destination": "/views/sw.js" }
  ],
  "crons": [
    {
      "path": "/api/cron-monthly-drip",
      "schedule": "0 1 * * *"
    }
  ]
}
