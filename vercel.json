{
  "version": 2,
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/views/index.html" },
    { "source": "/pusher.html", "destination": "/views/pusher.html" },
    { "source": "/invoicing.html", "destination": "/views/invoicing.html" },
    { "source": "/highlight.html", "destination": "/views/highlight.html" },
    { "source": "/settings.html", "destination": "/views/settings.html" },
    { "source": "/logs.html", "destination": "/views/logs.html" },
    { "source": "/rewards.html", "destination": "/views/rewards.html" },
    { "source": "/leaderboard.html", "destination": "/views/leaderboard.html" },
    { "source": "/inbox.html", "destination": "/views/inbox.html" },
    { "source": "/manifest.json", "destination": "/public/manifest.json" },
    { "source": "/sw.js", "destination": "/public/sw.js" }
  ],
  "crons": [
    {
      "path": "/api/cron-monthly-drip",
      "schedule": "0 1 * * *"
    }
  ]
}
